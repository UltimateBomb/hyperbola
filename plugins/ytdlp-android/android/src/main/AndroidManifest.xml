<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permissions live in the app manifest; the library declares only the
         service that keeps downloads running while the phone sleeps. -->
    <application>
        <service
            android:name="app.hyperbola.ytdlp.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
